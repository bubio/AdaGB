with "config/adagb_config.gpr";
with "df_imgui.gpr";
project Adagb is
   Imgui_Dir := Df_Imgui'Project_Dir & "vendor/cimgui/imgui";
   SDL_Dir := external ("SDL2_PREFIX", "/opt/homebrew/opt/sdl2-compat");
   MacOS_Min := external ("MACOSX_DEPLOYMENT_TARGET", "13.5");
   for Languages use ("Ada", "C++");
   for Source_Dirs use ("src/", "config/", "vendor/imgui_backends");
   for Object_Dir use "obj/" & Adagb_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("adagb.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        Adagb_Config.Ada_Compiler_Switches &
        ("-mmacosx-version-min=" & MacOS_Min);
      for Driver ("C++") use "/usr/bin/clang++";
      for Default_Switches ("C++") use
        ("-std=c++11", "-g", "-Wall", "-Wextra",
         "-mmacosx-version-min=" & MacOS_Min,
         "-I" & Imgui_Dir,
         "-I" & Project'Project_Dir & "vendor/imgui_backends",
         "-I" & SDL_Dir & "/include/SDL2");
   end Compiler;

   package Linker is
      for Default_Switches ("Ada") use
        ("-mmacosx-version-min=" & MacOS_Min,
         "-L" & SDL_Dir & "/lib", "-lSDL2");
   end Linker;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Adagb;
